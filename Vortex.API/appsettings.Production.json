{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "ConnectionStrings": {
    "DatabaseConnections": "production_database_connection_string"
  },
  "RabbitMq": {
    "Host": "production_rabbitmq_host",
    "Username": "production_rabbitmq_username",
    "Password": "production_rabbitmq_password"
  },
  "JwtSettings": {
    "Issuer": "production_issuer",
    "Audience": "production_audience",
    "AuthenticationSecretKey": "production_authentication_secret_key",
    "AuthorizationSecretKey": "production_authorization_secret_key",
    "ExpirationInDays": 7
  },
  "AllowedHosts": "*"
}
